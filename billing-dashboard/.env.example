NODE_ENV=development
PORT=3000
# Set to false only after configuring MariaDB below. Demo changes reset on restart.
DEMO_MODE=true
SESSION_SECRET=replace-with-at-least-32-random-characters
ACCOUNTANT_USERNAME=accountant
# Generate with: node -e "console.log(require('bcryptjs').hashSync('change-this-password', 12))"
ACCOUNTANT_PASSWORD_HASH=$2a$12$replace_with_bcrypt_hash
# Optional second role; may view but cannot edit billing.
VIEWER_USERNAME=
VIEWER_PASSWORD_HASH=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=billing_app
DB_PASSWORD=change-me
DB_NAME=akhurath_studio
DB_CONNECTION_LIMIT=5

# Must be a private, HTTPS n8n webhook reachable by this server.
N8N_DELIVERY_WEBHOOK_URL=
N8N_DELIVERY_TOKEN=replace-with-a-long-random-shared-secret
# n8n can poll eligible rows using GET /api/n8n/eligible with this bearer token.
N8N_API_TOKEN=replace-with-another-long-random-secret
# Optional public base URL used for links in webhook payloads.
PUBLIC_BASE_URL=http://localhost:3000
