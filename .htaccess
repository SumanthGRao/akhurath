<IfModule mod_rewrite.c>
  RewriteEngine On
  # If the app lives in a subfolder, set e.g. RewriteBase /subfolder/
  RewriteRule ^packages/?$ packages.php [L,QSA]
  RewriteRule ^privacy-policy/?$ privacy-policy.php [L,QSA]
  RewriteRule ^paste/?$ paste.php [L,QSA]
  RewriteRule ^paste/([a-zA-Z0-9]+)/?$ paste.php?id=$1 [L,QSA]
</IfModule>
